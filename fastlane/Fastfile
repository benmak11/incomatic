default_platform(:ios)

APP_IDENTIFIER    = "com.makusha.incomatic"
WIDGET_IDENTIFIER = "com.makusha.incomatic.IncomaticWidget"
APP_TARGET        = "incomatic"
WIDGET_TARGET     = "IncomaticWidgetExtension"
SCHEME            = "incomatic"
PROJECT           = "incomatic.xcodeproj"

platform :ios do
  before_all do
    setup_ci  # temporary keychain on CI runners (no-op locally)
    app_store_connect_api_key(
      key_id:                ENV["ASC_KEY_ID"],
      issuer_id:             ENV["ASC_ISSUER_ID"],
      key_content:           ENV["ASC_KEY_P8"],  # base64 of the .p8
      is_key_content_base64: true
    )
  end

  desc "Build and push a new build to TestFlight"
  lane :beta do
    # The git tag is the single source of truth for the marketing version, and
    # it is resolved first so a bad ref fails in seconds rather than after
    # match, a full archive, and an upload.
    #
    # This errors instead of falling back, deliberately. The previous version
    # kept whatever MARKETING_VERSION happened to be committed whenever
    # GITHUB_REF_NAME wasn't a tag — a workflow_dispatch run, or a local one —
    # which is how the project file sat at 1.7.0 while releases shipped past
    # it. A silent fallback is what made that invisible for four releases.
    version_ref = ENV["VERSION_NAME"] || ENV["GITHUB_REF_NAME"].to_s
    version = version_ref.to_s.delete_prefix("v")
    unless version.match?(/\A\d+\.\d+\.\d+\z/)
      UI.user_error!(
        "The beta lane must build from a version tag like v1.2.3, but got " \
        "'#{version_ref}'. Push a tag to release, or set VERSION_NAME=1.2.3 " \
        "to run this lane locally."
      )
    end

    match(type: "appstore", readonly: is_ci)
    build_number = increment_build_number(
      build_number: latest_testflight_build_number(app_identifier: APP_IDENTIFIER) + 1
    )
    # Stamped via xcargs rather than increment_version_number: agvtool cannot
    # set the marketing version on this project, because Info.plist holds the
    # $(MARKETING_VERSION) variable rather than a literal, and
    # `agvtool what-marketing-version` errors out on it. Build numbers are
    # fine, which is why increment_build_number above works.
    version_xcargs = "MARKETING_VERSION=#{version}"
    # The project uses automatic signing locally (for Xcode archives). On CI, force
    # manual signing so gym uses the match-provided distribution profile instead of
    # trying (and failing) to auto-generate one.
    #
    # Scoped per target. The widget extension is signed with its own profile:
    # an appex is a separate code-signed bundle with its own bundle id, so one
    # profile cannot cover both, and leaving the extension on automatic signing
    # while the app is manual fails the export rather than falling back.
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  PROJECT,
      targets:               [APP_TARGET],
      bundle_identifier:     APP_IDENTIFIER,
      team_id:               "X8E58H8HK5",
      code_sign_identity:    "Apple Distribution",
      profile_name:          "match AppStore #{APP_IDENTIFIER}"
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  PROJECT,
      targets:               [WIDGET_TARGET],
      bundle_identifier:     WIDGET_IDENTIFIER,
      team_id:               "X8E58H8HK5",
      code_sign_identity:    "Apple Distribution",
      profile_name:          "match AppStore #{WIDGET_IDENTIFIER}"
    )
    build_app(
      project:       PROJECT,
      scheme:        SCHEME,
      export_method: "app-store",
      xcargs:        version_xcargs,
      export_options: {
        signingStyle:         "manual",
        provisioningProfiles: {
          APP_IDENTIFIER    => "match AppStore #{APP_IDENTIFIER}",
          WIDGET_IDENTIFIER => "match AppStore #{WIDGET_IDENTIFIER}"
        }
      }
    )
    upload_to_testflight(
      app_identifier:                    APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
      distribute_external:               false  # internal only until an external group exists
    )

    # Record what shipped back into git. The build number is chosen from
    # App Store Connect at build time and is written nowhere else, so without
    # this a shipped build cannot be mapped back to a commit from the repo
    # alone. The tag is deliberately namespaced under build/ so it never
    # matches the v* trigger and cannot start another release.
    #
    # Non-fatal: the upload has already succeeded by this point, and losing a
    # traceability marker is not worth failing a release that shipped fine.
    begin
      add_git_tag(tag: "build/#{version}+#{build_number}")
      push_git_tags
    rescue => e
      UI.important("Shipped, but the build/#{version}+#{build_number} tag was not pushed: #{e.message}")
    end
  end

  desc "Promote the latest build to App Store review"
  lane :release do
    deliver(
      submit_for_review:                true,
      automatic_release_after_approval: true,
      force:                            true,   # skip HTML confirmation
      skip_screenshots:                 true,   # manage screenshots manually the first time
      skip_metadata:                    false
    )
  end
end
