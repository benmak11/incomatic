// Secrets.xcconfig.example — committed template.
// Copy to Config/Secrets.xcconfig (gitignored) and set the real backend host:
//   cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
//
// xcconfig parses "//" as a line comment, so the URL scheme uses the $() escape
// trick to keep the slashes literal at build time. Keep that format — a plain
// https:// would be truncated to "https:" and the app would ship with no backend.

API_BASE_URL_PROD = https:/$()/YOUR-CLOUD-RUN-HOST.a.run.app
